# PUBLIC_INTERFACE
# Backend environment configuration for FastAPI service.

# Optional: Explicitly allow a single frontend origin for CORS, e.g.
# PREVIEW_FRONTEND_ORIGIN=https://<your-preview-host>:3000
PREVIEW_FRONTEND_ORIGIN=

# Optional: Comma-separated list of extra CORS origins
# CORS_EXTRA_ORIGINS=https://foo:3000,https://bar:3000
CORS_EXTRA_ORIGINS=

# Optional: Override workspace root for job storage (default: ./workspace)
BRANDING_WS_ROOT=

# Optional: Public base URL for generating absolute links (e.g., in responses)
# BASE_URL=https://<your-preview-host>:3001
BASE_URL=

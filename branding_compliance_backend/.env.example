# ===============================
# FastAPI Backend Environment Example
# ===============================
# Copy this file to ".env" and adjust values as needed.
# Do NOT commit real secrets.

# -------------------------------
# Server bind configuration
# -------------------------------
# Address and port the FastAPI/uvicorn server should bind to.
APP_HOST=0.0.0.0
APP_PORT=3001

# -------------------------------
# Public base URL for this backend
# -------------------------------
# Used by clients to build absolute links, and can be referenced in docs/links.
# Update when deploying behind a different host or reverse proxy.
BACKEND_BASE_URL=http://localhost:3001

# -------------------------------
# CORS Configuration
# -------------------------------
# Allowed origins must be comma-separated WITHOUT spaces.
# Include your React frontend local preview here so it can call the backend.
# Add any additional preview or deploy URLs as needed (e.g., https://your-preview.app).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Allowed HTTP methods for CORS (comma-separated).
# Typical values include: GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# Allowed headers for CORS (comma-separated).
# Include common fetch/axios headers.
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,Origin,User-Agent,Cache-Control,Pragma

# Whether to allow credentials (cookies/Authorization headers) in CORS (true/false).
CORS_ALLOW_CREDENTIALS=true

# -------------------------------
# Environment
# -------------------------------
# Optional environment designation: development | production
APP_ENV=development

# -------------------------------
# Workspace (optional)
# -------------------------------
# Root path for workspace storage. If not set, service will pick a writable temp path.
# Uncomment to override.
# BRANDING_WS_ROOT=./workspace

# -------------------------------
# Backward-compat CORS (optional)
# -------------------------------
# If the app still references these, they can be used to append additional origins.
# PREVIEW_FRONTEND_ORIGIN=
# CORS_EXTRA_ORIGINS=

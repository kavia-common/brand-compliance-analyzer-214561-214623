# Backend environment configuration

# Workspace root directory for job storage (do not commit actual .env with secrets)
# Defaults internally to /tmp/branding_workspace when not specified.
#BRANDING_WS_ROOT=./workspace

# CORS: set your frontend origin to allow browser requests (e.g., https://<host>:3000)
#PREVIEW_FRONTEND_ORIGIN=https://localhost:3000
# Additional allowed origins (comma-separated)
#CORS_EXTRA_ORIGINS=https://example.com,https://another-host:3000

# Detection engine settings
# DETECTOR: template|orb|hybrid
DETECTOR=hybrid
# QUALITY: fast|balanced|best
QUALITY=balanced
# Minimum confidence threshold for detections (0..1)
DETECTION_CONFIDENCE_THRESHOLD=0.75
